# Base URL of the Sclera API gateway. The browser calls this directly.
# Default points at the local docker-compose gateway.
VITE_API_BASE=http://localhost:8080

# Demo context used to scope API calls (matches the live backend data).
# NOTE: VITE_DEMO_DOCKER must not be a SQL reserved word — "default" crashes the
# backend device queries. The live gateway uses "right_wing".
VITE_DEMO_USER=admin
VITE_DEMO_DISPLAY=Master User
VITE_DEMO_VDMS=VDMS760
VITE_DEMO_DOCKER=right_wing
