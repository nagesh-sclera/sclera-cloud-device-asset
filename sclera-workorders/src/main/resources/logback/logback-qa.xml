    <appender name="UserActionLogServiceDebugLogger" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/UserActionLogService/Debug/UserActionLogServiceDebug.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
