            <pattern>%d %-4relative [%thread] [%X{requestId:-}] %-5level %logger{35} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="TicketServiceErrorLogger" class="ch.qos.logback.core.rolling.RollingFileAppender">
