        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d %-4relative [%thread] [%X{requestId:-}] %-5level %logger{35} - %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="TicketHistoryServiceErrorLogger" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/TicketHistoryService/Error/TicketHistoryServiceError.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/TicketHistoryService/Error/TicketHistoryServiceError.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <MaxFileSize>10MB</MaxFileSize>
