        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/UserActionLogService/Error/UserActionLogServiceError.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <MaxFileSize>10MB</MaxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>30MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d %-4relative [%thread] [%X{requestId:-}] %-5level %logger{35} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--    Per-class file logging (also reaches Console via additivity)    -->
    <logger name="io.sclera.workorder.service.impl.MaximoServiceImpl" additivity="true">
        <appender-ref ref="MaximoServiceDebugLogger"/>
        <appender-ref ref="MaximoServiceErrorLogger"/>
    </logger>
    <logger name="io.sclera.workorder.service.impl.TicketHistoryServiceImpl" additivity="true">
        <appender-ref ref="TicketHistoryServiceDebugLogger"/>
        <appender-ref ref="TicketHistoryServiceErrorLogger"/>
    </logger>
    <logger name="io.sclera.workorder.service.impl.TicketServiceImpl" additivity="true">
        <appender-ref ref="TicketServiceDebugLogger"/>
        <appender-ref ref="TicketServiceErrorLogger"/>
    </logger>
    <logger name="io.sclera.workorder.service.impl.UserActionLogServiceImpl" additivity="true">
        <appender-ref ref="UserActionLogServiceDebugLogger"/>
        <appender-ref ref="UserActionLogServiceErrorLogger"/>
    </logger>

    <root level="info">
        <appender-ref ref="Console"/>
    </root>
</configuration>