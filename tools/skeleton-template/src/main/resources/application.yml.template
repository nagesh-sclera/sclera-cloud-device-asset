server:
  port: {{port}}

spring:
  application:
    name: sclera-{{servicekey}}

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: always

dapr:
  http-port: ${DAPR_HTTP_PORT:3500}
  grpc-port: ${DAPR_GRPC_PORT:50001}

logging:
  level:
    io.sclera.{{servicekey}}: INFO
    io.dapr: INFO
